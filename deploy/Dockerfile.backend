FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 AXIOM_DATA_DIR=/data AXIOM_HOSTED_MODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
WORKDIR /srv
COPY backend/pyproject.toml backend/pyproject.toml
COPY backend/app backend/app
RUN python -m pip install --no-cache-dir ./backend && useradd --uid 10001 --create-home axiom && mkdir -p /data && chown axiom:axiom /data
USER axiom
EXPOSE 8000
CMD ["python","-m","app.hosted"]
