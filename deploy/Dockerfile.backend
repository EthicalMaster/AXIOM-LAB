FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 AXIOM_DATA_DIR=/data
WORKDIR /srv
COPY backend/pyproject.toml backend/pyproject.toml
COPY backend/app backend/app
RUN python -m pip install --no-cache-dir ./backend && useradd --uid 10001 --create-home axiom && mkdir -p /data && chown axiom:axiom /data
USER axiom
EXPOSE 8000
CMD ["uvicorn","app.main:app","--app-dir","/srv/backend","--host","0.0.0.0","--port","8000","--workers","1"]
