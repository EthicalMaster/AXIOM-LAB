# Copy to .env (ignored by Git). Local launcher: python scripts/start_backend.py.
# Optional owner-only Google authentication (do not expose shared data to other users).
AXIOM_GOOGLE_AUTH=0
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AXIOM_GOOGLE_OWNER_ID=
# Opt-in private beta. Verified UUIDs, comma separated. Owner is also admitted.
AXIOM_MULTI_USER=0
AXIOM_MULTI_USER_IDS=
# Optional cloud persistence; server-only key, never use a VITE_ prefix.
AXIOM_CLOUD_STORAGE=0
SUPABASE_SECRET_KEY=
AXIOM_CLOUD_GLOBAL_MIB=512
AXIOM_USER_INFLIGHT=2
AXIOM_USER_RPM=60
# Apply production SQL and verify two-user isolation before enabling either.
AXIOM_DISTRIBUTED_RPM=0
AXIOM_OPEN_REGISTRATION=0
AXIOM_BLOCKED_USER_IDS=

# All are optional: AI is disabled unless all three are configured.
AXIOM_AI_BASE_URL=https://your-openai-compatible-provider.example/v1
AXIOM_AI_MODEL=your-model-id
AXIOM_AI_API_KEY=
# For a trusted local loopback provider ONLY; never allow insecure remote URLs.
AXIOM_AI_ALLOW_LOOPBACK=0

# Single-user access when served behind HTTPS reverse proxy.
# Set to 1 ONLY if you have a strong token (generate with `python -c "import secrets;print(secrets.token_urlsafe(32))"`).
AXIOM_PUBLIC_MODE=0
AXIOM_ACCESS_TOKEN=

# Set to the exact HTTPS frontend origin when serving via a reverse proxy.
AXIOM_PUBLIC_ORIGIN=
# Process-local conservative admission controls; restart to change budgets.
AXIOM_MAX_INFLIGHT=4
AXIOM_API_RPM=120
AXIOM_UPLOAD_RPM=6
AXIOM_COMPUTE_RPM=30
AXIOM_GUIDE_RPM=20
AXIOM_LOGIN_RPM=12
AXIOM_AI_RPM=10
AXIOM_AI_RPD=100
AXIOM_DATASET_QUOTA_MIB=256
AXIOM_DATASET_MAX_COUNT=500

# Hosted container: set AXIOM_HOSTED_MODE=1, AXIOM_PUBLIC_MODE=1 and mount AXIOM_DATA_DIR.
# Local Compose explicitly opts out of hosted preflight. Do not use local mode on the internet.
