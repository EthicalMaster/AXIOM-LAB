# All are optional: AI is disabled unless all three are configured.
AXIOM_AI_BASE_URL=https://your-openai-compatible-provider.example/v1
AXIOM_AI_MODEL=your-model-id
AXIOM_AI_API_KEY=
# For a trusted local loopback provider ONLY; never allow insecure remote URLs.
AXIOM_AI_ALLOW_LOOPBACK=0

# Single-user access when served behind HTTPS reverse proxy.
# Set to 1 ONLY if you have a strong token (generate with `python -c "import secrets;print(secrets.token_urlsafe(32))"`).
AXIOM_PUBLIC_MODE=0
AXIOM_ACCESS_TOKEN=
